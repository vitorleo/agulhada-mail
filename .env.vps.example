PORT=3007
PUBLIC_BASE_URL=https://email.agulhada.com

# Inside the vps-docker compose network, use the MongoDB service name.
# The existing Mongo user is scoped to the needles database, so keep this app's
# MVP collections in needles unless you also create a dedicated agulhada_mail DB user.
MONGO_DATABASE_URL=mongodb://mulamanca:CHANGE_ME@mongodb:27017/needles?authSource=needles
MONGO_DATABASE_NAME=needles

AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
SES_FROM_EMAIL=marketing@email.agulhada.com
SES_FROM_NAME=Agulhada.com
SES_CONFIGURATION_SET=my-first-configuration-set

API_ADMIN_TOKEN=CHANGE_ME
UNSUBSCRIBE_SECRET=CHANGE_ME_MIN_24_CHARS
SNS_WEBHOOK_SECRET=CHANGE_ME

WORKER_BATCH_SIZE=25
WORKER_POLL_MS=5000
SEND_RATE_PER_SECOND=1
